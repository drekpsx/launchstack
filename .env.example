# Supabase project connection (frontend-safe, anon/publishable key only)
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-public-key"

# Base URL of the deployed app (used for links, Stripe redirects, etc.)
VITE_APP_URL="http://localhost:8080"

# --- Stripe (server-side only — set as Supabase Edge Function secrets, ---
# --- NEVER as VITE_ variables, never in this file for real values) ---
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_ID_PRO=
# See supabase/functions/README.md for the full setup.
